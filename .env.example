# Copy this file to .env (in this hw4/ folder) and fill in your own values.
# Never commit the real .env — it is listed in .gitignore.

# Required: API key for the Portkey AI gateway (used by the PydanticAI agent, model gpt-5.6-luna)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: any long random string. Keeps shoppers logged in across backend restarts.
AUTH_SECRET_KEY=change-me-to-a-long-random-string

# Optional: max seconds the agent may think per chat message (default 25)
AGENT_TIMEOUT_SECONDS=25
